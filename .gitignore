# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO commit the example template, so a fresh clone knows what to fill in.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client is generated code — rebuilt by `npm install` (see the
# "postinstall" script in package.json), so it doesn't belong in git.
/src/generated/prisma

# The SQLite database itself. This is *our data*, not source code: it's personal,
# it changes constantly, and every machine should have its own.
*.db
*.db-journal
