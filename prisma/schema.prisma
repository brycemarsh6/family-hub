// This file describes the shape of our data. Prisma reads it and generates
// type-safe code we use to read and write the database.
//
// IMPORTANT (see README): we deliberately avoid Prisma `enum` types and any
// database-specific attributes. SQLite does not support enums, and keeping the
// schema to the lowest common denominator means moving to hosted Postgres later
// is a provider swap plus one migration, not a rewrite. The set of allowed
// values for `category` and `location` is enforced in TypeScript instead, in
// src/lib/constants.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Something we need to buy. Lives on the shopping list until it's checked off.
model GroceryItem {
  id       String  @id @default(cuid())
  name     String
  quantity Float   @default(1)
  unit     String? // "lbs", "cans", "bunch" — optional, many items are just a count
  category String  @default("Other")
  checked  Boolean @default(false)
  /// Retired in place — superseded by addedById below. Kept, not dropped or
  /// backfilled, per the additive-only rule on the live database; nothing
  /// reads or writes this column anymore.
  addedBy  String?
  note     String?
  store    String? // "Walmart" | "Costco" | "Amazon" | "Target" | "Maceys" | "Other" | null (not chosen yet)

  /// Who added this to the list — null for rows created before accounts
  /// existed, or by a path that doesn't carry an actor (e.g. voice's legacy
  /// unattributed token). SetNull, same pattern as pantryItemId below: a
  /// deactivated or deleted person must never take a grocery-list row with
  /// them.
  addedById String?
  addedByUser User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  /// Where this should land in the inventory on "Put away" — an override,
  /// not a description of where it is now (a grocery item isn't stored
  /// anywhere yet). Null means "no opinion": put-away keeps its default
  /// behavior (an existing item stays where it already is; a brand-new one
  /// lands in DEFAULT_LOCATION). A value moves an existing item too, which
  /// is what makes "put the beef in the fridge, not the freezer, I'm
  /// cooking it tonight" possible from the shopping list itself.
  location String?

  /// True only when the category above was deliberately changed in the
  /// edit sheet — never merely because it differs from a matched inventory
  /// item's own category. Quick-adds from the add bar and from voice both
  /// default to category "Other", so applying category on every mismatch
  /// would silently re-file real inventory items (e.g. Milk) into "Other"
  /// on a routine put-away. This flag is what lets a genuine correction
  /// (Ground beef: Other -> Meat) propagate while an unedited default
  /// doesn't.
  categoryEdited Boolean @default(false)

  // Set when this item was generated from a pantry item running low. It's what
  // lets "put away" know which pantry item to top up, and prevents us adding
  // the same pantry item to the list twice.
  pantryItemId String?
  pantryItem   PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  checkedAt DateTime?

  @@index([pantryItemId])
  @@index([addedById])
}

/// One change made by voice, kept so it can be read back or undone.
///
/// Voice is the one way into this app where nobody sees what they typed — a
/// misheard word becomes a wrong number with no visible trace. Every voice
/// change writes a row here so "undo that" has something real to reverse, and
/// so a count that looks wrong later can be explained.
model VoiceChange {
  id String @id @default(cuid())

  /// What was actually said, as the phone or Echo transcribed it. Kept for
  /// exactly the case above: working out why a count is wrong.
  transcript String

  /// "use" | "add" | "buy" — which verb the parser decided on.
  action String

  /// The pantry item that changed. Null for a "buy" (that writes to the
  /// grocery list) or when the item was created by this change.
  pantryItemId String?
  pantryItem   PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)

  /// The item name as matched, kept as plain text so the log still reads
  /// correctly after the item itself is renamed or deleted.
  itemName String

  /// Quantity before and after, so undo is a straight restore rather than
  /// arithmetic that could drift.
  quantityBefore Float?
  quantityAfter  Float?

  /// Set once this row has been undone, so the same change can't be
  /// reversed twice.
  undoneAt DateTime?

  /// Who spoke this change — null for the legacy shared VOICE_API_TOKEN
  /// (unattributed) and for anyone deactivated or deleted since. SetNull
  /// rather than a required FK: this row is a log entry, and a log entry
  /// must survive the person it's about. Deliberately NOT re-pointed by a
  /// pantry-item merge (see IrregularityDismissal's mergePantryItems) —
  /// this field identifies the speaker, not the item, so a merge has no
  /// reason to touch it.
  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// Something we already own, and where it's stored.
model PantryItem {
  id       String  @id @default(cuid())
  name     String
  location String  @default("Pantry") // "Pantry" | "Fridge" | "Freezer" | "Storage"
  quantity Float   @default(1)
  unit     String?
  category String  @default("Other")

  /// When quantity drops to this number or below, the item counts as "running low".
  lowThreshold Float @default(1)

  /// A real expiry date somebody read off the packet and typed in.
  ///
  /// Almost always null: nobody is going to hand-enter dates for 461 items,
  /// so the Expiring page estimates instead (see src/lib/shelfLife.ts). When
  /// this IS set it wins over any estimate, because a printed date beats a
  /// guess. Leftovers get it set automatically from the days-good picker.
  expiresAt DateTime?

  /// When we last got more of this — the clock estimates count from.
  ///
  /// Deliberately not `createdAt`: every one of the 461 imported items was
  /// created on the same August 2026 afternoon, so counting from creation
  /// would peg the whole pantry to one date forever. This moves whenever
  /// quantity goes UP (put-away, voice "add", manual increase), so the
  /// estimate self-corrects as the house actually shops.
  restockedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groceryItems GroceryItem[]
  voiceChanges VoiceChange[]

  @@index([location])
  /// The Expiring page's main query: things with a real date, soonest first.
  @@index([expiresAt])
}

/// Something the household knows how to cook. Ingredients and steps are
/// stored as plain newline-separated text (one entry per line), not a
/// sub-table or a Postgres String[] — scalar lists aren't available on
/// SQLite, and the project avoids provider-specific schema features.
model Recipe {
  id String @id @default(cuid())

  title       String
  ingredients String // one ingredient per line
  steps       String // one step per line

  /// Free text on purpose — "6-8", "2 loaves", "45 min" are all real answers
  /// nobody wants forced into a number field.
  servings String?
  prepTime String?
  cookTime String?

  /// Where this came from, if it was imported rather than typed by hand.
  sourceUrl String?
  notes     String?

  /// Null until the recipe is first shared. Set to a fresh random value to
  /// share, cleared ("Stop sharing") to revoke — the old link just 404s from
  /// then on, since the public page looks a row up by this value.
  shareToken String? @unique

  /// 1-5, one tap in RecipeStars. Tapping the current value clears it back
  /// to null (unrated) rather than requiring a separate "clear" control.
  rating Int?

  /// Set whenever "Mark as cooked" is tapped — a timestamp, deliberately not
  /// a boolean. "Mark as cooked" always stamps *now*, overwriting whatever
  /// was there; the eventual Cooked filter (C4) is just "is this set"; and a
  /// real date is something the meal-plan AI can eventually reason about
  /// ("you haven't made this since March") that a boolean never could, for
  /// the same storage cost.
  lastCookedAt DateTime?

  mealPlanEntries MealPlanEntry[]
  cookbooks       CookbookRecipe[]
  tags            RecipeTag[]

  /// Nutrition is estimated once, stored, and marked honest — never
  /// recomputed silently. All four are null until "Calculate nutrition" is
  /// first run, and all four are set together (one Claude call, one write).
  /// Whole numbers on purpose: an AI estimate doesn't have decimal
  /// precision, and 12.4g reads as more precise than it is.
  nutritionCalories Int?
  nutritionProteinG Int?
  nutritionCarbsG   Int?
  nutritionFatG     Int?

  /// The servings number the estimate was computed per — a hard integer
  /// from a stepper, deliberately never `servings` itself (which stays
  /// free text like "6-8" and must never be overwritten by a nutrition
  /// calculation).
  nutritionServings Int?

  /// A fingerprint of `ingredients` at the moment nutrition was computed.
  /// Compared against a fresh fingerprint of the current `ingredients` on
  /// every render (src/lib/nutritionFingerprint.ts) — a mismatch means the
  /// ingredient list changed since, and the stored numbers describe a
  /// recipe that no longer exists. Shown as a "computed for an older
  /// ingredient list" notice rather than silently mislabeling a different
  /// recipe as this one's nutrition.
  nutritionFingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A label a recipe can carry. Tags are a table + join, never plain text on
/// the recipe — that's what makes rename safe (rename once, every recipe
/// follows) and delete honest (the confirm sheet can show a real count of
/// how many recipes it's on). `name` is unique, but that uniqueness is
/// case-SENSITIVE at the database level (same "no provider-specific
/// features" reasoning as the rest of this schema) — the case-insensitive
/// "search or create" rule from the Recipes v2 plan is enforced in
/// findOrCreateTag (src/app/actions/tags.ts), not here.
///
/// The four meal-slot tags (Breakfast/Lunch/Dinner/Snacks) are seeded from
/// MEAL_SLOTS by exact name (see prisma/seed-slot-tags.ts) — everything
/// else is freely user-created. Renaming or deleting one of those four is
/// allowed like any other tag; it just means suggestMealsForSlot's
/// exact-name lookup stops finding it and quietly falls back to the full
/// recipe library, not a crash.
model Tag {
  id   String @id @default(cuid())
  name String @unique

  recipes RecipeTag[]

  createdAt DateTime @default(now())
}

/// One tag applied to one recipe.
model RecipeTag {
  id String @id @default(cuid())

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  @@unique([recipeId, tagId])
  @@index([tagId])
}

/// A named list of recipes — "Mom's Recipes", "Quick Weeknight Dinners".
/// Membership lives in the join table below, not on Recipe itself, since a
/// recipe can belong to many cookbooks or none.
model Cookbook {
  id    String @id @default(cuid())
  title String

  /// Null until first shared — same pattern as Recipe.shareToken, reused for
  /// cookbook viewer links (see the Recipes v2 plan's C8 phase).
  shareToken String? @unique

  recipes CookbookRecipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One recipe filed into one cookbook.
///
/// Deleting a Cookbook cascades here only — it unfiles every recipe but
/// never deletes the recipes themselves. Deleting a Recipe also cascades
/// here, for the opposite reason: a join row pointing at a recipe that no
/// longer exists is meaningless, so it goes with the recipe.
model CookbookRecipe {
  id String @id @default(cuid())

  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  cookbookId String

  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  /// When this recipe was added to this cookbook — not reused from either
  /// side's own createdAt/updatedAt. "Most recently added to" means "when
  /// was a recipe last filed into this book", which a cookbook-level
  /// timestamp would get wrong (renaming the cookbook, or filing a recipe
  /// into a different one, shouldn't move this book's sort position).
  addedAt DateTime @default(now())

  @@unique([cookbookId, recipeId])
  @@index([recipeId])
}

/// One planned week. `weekStart` is always a Sunday (see src/lib/mealPlanDates.ts)
/// stored as a plain calendar date — never derived from milliseconds, since a
/// week can be 167 or 169 hours long across a daylight-saving change and
/// millisecond arithmetic silently drifts across one.
model MealPlan {
  id        String   @id @default(cuid())
  weekStart DateTime @unique

  entries MealPlanEntry[]

  createdAt DateTime @default(now())

  @@index([weekStart])
}

/// One meal, in one slot, on one day of a MealPlan.
///
/// `title` is always set and is what actually renders — `recipeId` is a soft
/// link for "jump to this recipe" and nothing else. Deleting a recipe must
/// never hollow out a week that already happened, so the link goes null
/// (same pattern as GroceryItem.pantryItemId) while the title survives.
model MealPlanEntry {
  id String @id @default(cuid())

  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealPlanId String

  /// 0 = the plan's own Sunday, ... 6 = the following Saturday. The entry's
  /// real calendar date is always derived (mealPlan.weekStart + dayOffset),
  /// never stored — one source of truth for "what date is this."
  dayOffset Int

  /// "Breakfast" | "Lunch" | "Dinner" | "Snacks" — see src/lib/constants.ts.
  slot String

  title String

  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One meal per slot per day — filling an already-filled slot is an
  /// upsert on this key, not a second row.
  @@unique([mealPlanId, dayOffset, slot])
  @@index([recipeId])
}

/// A "stop asking me about this" record for the irregularity review queue.
///
/// The irregularities themselves are never stored — they're recomputed from
/// live data on every page load, exactly like low counts and expiry
/// estimates (see src/lib/duplicates.ts). This table is the one thing that
/// genuinely must persist: without it, a queue that pulses at the family
/// would keep re-raising things they've already decided are fine, which is
/// precisely how these features get ignored and die.
///
/// Deliberately NOT a foreign key to PantryItem. The fingerprint is a plain
/// string covering both shapes a dismissal can take — a pair of item ids
/// (sorted, so order can't produce two records for one decision) or a single
/// id — and the rows it references may be deleted by the very merge the
/// dismissal was recorded alongside. A dangling fingerprint is harmless: it
/// just never matches anything again.
model IrregularityDismissal {
  id String @id @default(cuid())

  /// Which detector raised it: "same-name" | "subset-name" |
  /// "other-location" | "other-category". Part of the fingerprint already,
  /// but stored separately so a detector can be retired by deleting its
  /// dismissals without parsing strings.
  kind String

  /// Stable, order-independent identity for the thing being dismissed —
  /// built by src/lib/duplicates.ts so the detectors and this table can
  /// never disagree about what "the same irregularity" means.
  fingerprint String @unique

  createdAt DateTime @default(now())

  @@index([kind])
}

/// A person in the household, or the wall tablet. One model for both tiers
/// (login accounts and non-login profiles) and for device mode too — see the
/// Family Accounts v1 plan (.avengers/plans/family-accounts-v1.md) for the
/// full reasoning; this comment covers only the two decisions that would
/// otherwise look like missing fields.
///
/// **No `kind` column.** `passwordHash` null means "a non-login profile" (a
/// real household member — a little kid, say — who can be attributed to
/// chores or a meal plan later but doesn't sign in); set means "an account".
/// Upgrading a profile to an account later is one field going from null to
/// set, not a migration or a second table.
///
/// **Device mode is `role: "device"`, not a separate flag or a session-only
/// concept.** The wall tablet signs in once, long-lived, as a real User row
/// — a boolean flag pointing at a person (e.g. Bryce) would make every
/// tablet-originated change lie about who actually acted. Keeping it on the
/// same `role` axis as admin/parent/kid means role gates, header chrome, and
/// the future tap-your-name actor picker all read one field instead of two
/// that could disagree.
model User {
  id String @id @default(cuid())

  displayName String

  /// "admin" | "parent" | "kid" | "device" — see ROLES/Role/toRole in
  /// src/lib/constants.ts. Defaults to the least-privileged real-person
  /// role; nothing here ever defaults to "admin" or "device".
  role String @default("kid")

  /// Null = a non-login profile. Set = an account. See the model doc above.
  /// bcryptjs, cost 11 — src/lib/password.ts.
  passwordHash String?

  /// A fixed swatch NAME (e.g. "blue"), not a hex value, from AVATAR_COLORS
  /// (src/lib/constants.ts) — an initial + color circle, deliberately not
  /// stored image bytes (no blob storage in this stack; see the Recipes v2
  /// plan's C7 for why that's a billing decision, not a technical one).
  /// Stored as a name rather than a hex so the palette can be retuned later
  /// (darkening a hue for dark-mode contrast, say) without stranding every
  /// existing row on a color value that's no longer in the list.
  avatarColor String

  /// SHA-256 of this person's personal Siri/voice token — the raw token is
  /// shown once at issue time and never stored, the same reasoning as a
  /// password hash. Unique so two people can never collide onto the same
  /// token by accident. Null until a token is issued (Phase 5).
  voiceTokenHash String? @unique

  /// Soft deactivation, never a delete — a person with attributed rows
  /// (grocery items, voice changes, eventually chores) must keep existing
  /// underneath them. Set = can no longer sign in or act; null = active.
  deactivatedAt DateTime?

  groceryItemsAdded GroceryItem[]
  voiceChanges      VoiceChange[]

  // No relation to LoginAttempt here — see that model's own doc comment for
  // why userId there is deliberately not a foreign key.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One login attempt, success or failure — the durable half of rate
/// limiting. An in-memory counter dies with every serverless invocation, so
/// the real "how many recent failures" state has to live here instead.
///
/// **Deliberately no foreign key on `userId`.** Same reasoning as
/// IrregularityDismissal: this is disposable telemetry, not a relationship
/// that needs referential integrity, and a userId that outlives the User row
/// it named (or was never a real id at all — a forged login POST can claim
/// anything) is harmless here in a way a broken FK constraint wouldn't be.
model LoginAttempt {
  id String @id @default(cuid())

  /// The id the attempt claimed to be logging in as — not a relation, see
  /// above. Null for a device-chip or malformed attempt with no claimed
  /// identity at all.
  userId String?

  /// First hop of x-forwarded-for — best-effort, not a guarantee (see the
  /// plan's "honest limits": the per-user cap is the real bound).
  ip String

  success Boolean

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}
