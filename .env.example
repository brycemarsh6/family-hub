# Copy this file to `.env` and the app will run.
#   cp .env.example .env
#
# .env itself is never committed to git, because it holds real secrets. This
# example file is the committed template.

# The database connection string.
# Locally this is SQLite in a single file. In production it's a Postgres URL.
DATABASE_URL="file:./prisma/dev.db"

# Signs the login session cookie. Anyone holding this value can forge a
# session, so treat it like a password.
#   Generate one with:  openssl rand -base64 32
# Use a DIFFERENT value in production than the one on your laptop.
SESSION_SECRET="run-openssl-rand-base64-32-and-paste-the-result-here"

# There is no single shared family password anymore — Family Accounts v1
# replaced it with a per-person account in the database (the User table),
# each with its own hashed password. There's nothing to set here for that;
# real people are created by running, once, in your own terminal:
#   npm run db:bootstrap-users

# Shared secret Alexa/Siri send in the x-voice-token header when they call
# /api/voice — that endpoint can't use the session cookie, since neither
# platform can sign in.
#   Generate one with:  openssl rand -base64 32
VOICE_API_TOKEN="run-openssl-rand-base64-32-and-paste-the-result-here"

# Used by src/lib/voice/parse.ts (and every other Claude API call in this
# app) to turn spoken/typed sentences into structured actions. Bryce creates
# the Anthropic API account; the key lives here locally and in the host's
# env vars in production, never in chat or git.
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# The Alexa skill's own applicationId, from the Alexa developer console
# (Build tab → Endpoint) once the skill exists. /api/alexa checks this
# against every request's envelope so a validly-signed request meant for
# someone else's skill can't be replayed against this endpoint — see
# isFromOurSkill in src/lib/voice/alexa.ts. Unset means /api/alexa rejects
# every request, including genuine ones, which is the intended fail-closed
# state until the skill is created.
ALEXA_SKILL_ID="amzn1.ask.skill.your-skill-id-here"
