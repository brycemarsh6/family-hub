# Copy this file to `.env` and the app will run.
#   cp .env.example .env
#
# .env itself is never committed to git, because it holds real secrets. This
# example file is the committed template.

# The database connection string.
# Locally this is SQLite in a single file. In production it's a Postgres URL.
DATABASE_URL="file:./prisma/dev.db"

# Signs the login session cookie. Anyone holding this value can forge a
# session, so treat it like a password.
#   Generate one with:  openssl rand -base64 32
# Use a DIFFERENT value in production than the one on your laptop.
SESSION_SECRET="run-openssl-rand-base64-32-and-paste-the-result-here"

# The single shared password the whole family types to get in. There are no
# individual accounts yet — see the auth notes in CLAUDE.md.
FAMILY_PASSWORD="pick-something-long-here"
