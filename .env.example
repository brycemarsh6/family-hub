# Copy this file to `.env` and the app will run.
#   cp .env.example .env
#
# .env itself is never committed to git, because it holds real secrets. This
# example file is the committed template.

# The database connection string.
# Locally this is SQLite in a single file. In production it's a Postgres URL.
DATABASE_URL="file:./prisma/dev.db"

# Signs the login session cookie. Anyone holding this value can forge a
# session, so treat it like a password.
#   Generate one with:  openssl rand -base64 32
# Use a DIFFERENT value in production than the one on your laptop.
SESSION_SECRET="run-openssl-rand-base64-32-and-paste-the-result-here"

# There is no single shared family password anymore — Family Accounts v1
# replaced it with a per-person account in the database (the User table),
# each with its own hashed password. There's nothing to set here for that;
# real people are created by running, once, in your own terminal:
#   npm run db:bootstrap-users

# Shared secret Alexa/Siri send in the x-voice-token header when they call
# /api/voice — that endpoint can't use the session cookie, since neither
# platform can sign in.
#   Generate one with:  openssl rand -base64 32
VOICE_API_TOKEN="run-openssl-rand-base64-32-and-paste-the-result-here"

# SHA-256 hash of the bearer token the private Assistant API (/api/assistant/*)
# accepts. The value here is the HASH printed by `npm run assistant:token`,
# never the token itself. Leave it unset and the whole API is switched off.
# The raw token goes only into the bot's secure input — never in .env, chat,
# or git.
ASSISTANT_API_TOKEN_HASH=""

# Used by src/lib/voice/parse.ts (and every other Claude API call in this
# app) to turn spoken/typed sentences into structured actions. Bryce creates
# the Anthropic API account; the key lives here locally and in the host's
# env vars in production, never in chat or git.
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# The Alexa skill's own applicationId, from the Alexa developer console
# (Build tab → Endpoint) once the skill exists. /api/alexa checks this
# against every request's envelope so a validly-signed request meant for
# someone else's skill can't be replayed against this endpoint — see
# isFromOurSkill in src/lib/voice/alexa.ts. Unset means /api/alexa rejects
# every request, including genuine ones, which is the intended fail-closed
# state until the skill is created.
ALEXA_SKILL_ID="amzn1.ask.skill.your-skill-id-here"

# Winnie (the Grok bot) notification webhook. Both are secrets: set them only
# in Vercel (Sensitive). Unset means "Send test to Winnie" sends nothing.
# WINNIE_WEBHOOK_URL=""
# WINNIE_WEBHOOK_KEY=""

# Set to 1 ONLY in Bryce's own Vercel project. Turns on the owner-only features
# (Winnie, the Siri/Alexa voice doors, the morning briefing). Unset = a relative's copy.
# MARSHEE_OWNER_COPY=1

# Google calendar sync (Settings > Synced calendars). All three are secrets.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET go in Vercel (Sensitive) and in
# your local .env. TOKEN_ENCRYPTION_KEY has one value per environment: never
# reuse the production value locally. Unset means the page says sync isn't
# set up and the Link button is hidden.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# TOKEN_ENCRYPTION_KEY=""   # 32 random bytes, standard base64 (see src/lib/tokenCrypto.ts)

# Slideshow photos (Settings > Slideshow photos). Local development only: the
# DEV Blob store's read-write token, never the production store's. Vercel
# deployments use BLOB_STORE_ID plus automatic OIDC sign-in instead, so there
# is no token to paste there.
# BLOB_READ_WRITE_TOKEN=""

# Household time zone for this copy of the app. Set it once, before any data
# exists. Unset means America/Denver. A bad name fails the build.
# NEXT_PUBLIC_HOUSEHOLD_TIME_ZONE="America/Los_Angeles"

# Feedback forwarding (mission 90). A relative's copy sets the first three so
# its feedback also reaches Bryce; only Bryce's copy sets FEEDBACK_INBOX_KEY.
# The KEY and INBOX_KEY are the same secret (32+ characters). All are optional.
# FAMILY_NAME=""            # shown beside each forwarded report, e.g. "Smith family"
# FEEDBACK_FORWARD_URL=""   # https://<bryce's copy>/api/feedback-inbox
# FEEDBACK_FORWARD_KEY=""
# FEEDBACK_INBOX_KEY=""
